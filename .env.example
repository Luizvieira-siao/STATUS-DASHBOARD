# Modelo de configuração de produção. O .env na raiz é carregado automaticamente.
# Para desenvolvimento local, use DJANGO_DEBUG=1 e mantenha DATABASE_URL vazia.
# Variáveis já definidas no ambiente (incluindo Render) têm prioridade.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=gere-uma-chave-aleatoria-exclusiva
DJANGO_ALLOWED_HOSTS=dashboard.exemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.exemplo.com
DATABASE_URL=postgresql://usuario:senha@host:5432/status_dashboard
# Ative apenas atrás de um proxy confiável que sobrescreva X-Forwarded-Proto.
# No Render, essa configuração é automática.
DJANGO_TRUST_PROXY=0

# Relatórios por pergunta (não coloque uma chave real neste arquivo).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
